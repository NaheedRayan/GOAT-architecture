APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://goat:goat@localhost:5432/goat?sslmode=disable

# Required in production: `openssl rand -base64 32`
JWT_SEED=

# Bootstrap admin account (created on startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Store
SITE_NAME=GOAT Store
CURRENCY=USD
TAX_RATE_PERCENT=0
TAX_INCLUSIVE=false
TAX_LABEL=Tax
RETURN_WINDOW_DAYS=14
UPLOAD_DIR=./data/uploads

# Payments. card = a gateway you configure (none built in yet); cod = cash on delivery.
# PAYMENT_PROVIDER=mock is development only; production refuses it. With no gateway use:
#   PAYMENT_PROVIDER=none  PAYMENT_METHODS=cod
PAYMENT_PROVIDER=mock
PAYMENT_METHODS=card,cod
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Email (required in production). Without SMTP_ADDR emails are only logged.
MAIL_FROM=GOAT Store <no-reply@localhost>
# SMTP_ADDR=smtp.example.com:587
# SMTP_USER=
# SMTP_PASS=
# SMTP_TLS=starttls   # starttls | implicit | none

# Staff alerts and background jobs
# ALERT_EMAIL=ops@example.com
LOW_STOCK_THRESHOLD=5
ABANDONED_CART_HOURS=24

# Observability: set a token to enable GET /metrics (Authorization: Bearer <token>)
# METRICS_TOKEN=

# Behind a reverse proxy only:
# TRUST_PROXY=true
# PUBLIC_URL=https://shop.example.com
# DB_MAX_CONNS=20
