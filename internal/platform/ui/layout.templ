package ui

import (
	"strconv"

	"github.com/NaheedRayan/goat-architecture/internal/platform/auth"
	"github.com/NaheedRayan/goat-architecture/web"
)

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · GOAT Store</title>
			<meta name="description" content="GOAT Store"/>
			<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23ea580c'/%3E%3Ctext x='16' y='22' font-family='Arial' font-weight='800' font-size='18' text-anchor='middle' fill='white'%3EG%3C/text%3E%3C/svg%3E"/>
			<link rel="stylesheet" href={ "/static/app.css?v=" + web.Version() }/>
			<script defer src={ "/static/alpine.min.js?v=" + web.Version() }></script>
		</head>
		<body class="flex min-h-full flex-col bg-stone-50 font-sans text-stone-900 antialiased">
			@Header()
			<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
				{ children... }
			</main>
			<footer class="border-t border-stone-200 py-6 text-center text-sm text-stone-500">
				GOAT Store · Go, templ, Alpine.js, Tailwind
			</footer>
		</body>
	</html>
}

templ Header() {
	<header class="sticky top-0 z-10 border-b border-stone-200 bg-white/90 backdrop-blur" x-data="{ open: false }">
		<div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3">
			<a href="/" class="text-lg font-extrabold tracking-tight text-brand-600">GOAT<span class="text-stone-900">Store</span></a>
			<form action="/products" method="get" class="mx-4 hidden max-w-md flex-1 md:block">
				<input type="search" name="q" placeholder="Search products…" class="input" aria-label="Search products"/>
			</form>
			<nav class="ml-auto hidden items-center gap-5 text-sm font-medium md:flex">
				<a href="/products" class="hover:text-brand-600">Shop</a>
				@accountLinks()
				<a href="/cart" class="relative hover:text-brand-600">
					Cart
					if n := CartCount(ctx); n > 0 {
						<span class="ml-1 rounded-full bg-brand-600 px-2 py-0.5 text-xs font-semibold text-white">{ strconv.Itoa(n) }</span>
					}
				</a>
			</nav>
			<button type="button" class="ml-auto rounded-lg border border-stone-300 p-2 md:hidden" @click="open = !open" :aria-expanded="open" aria-label="Menu">
				<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
			</button>
		</div>
		<nav x-show="open" x-cloak class="flex flex-col gap-3 border-t border-stone-200 px-4 py-3 text-sm font-medium md:hidden">
			<a href="/products">Shop</a>
			@accountLinks()
			<a href="/cart">
				Cart
				if n := CartCount(ctx); n > 0 {
					<span>({ strconv.Itoa(n) })</span>
				}
			</a>
		</nav>
	</header>
}

templ accountLinks() {
	if c, ok := auth.FromContext(ctx); ok {
		if c.Role == auth.RoleAdmin {
			<a href="/admin" class="hover:text-brand-600">Admin</a>
		}
		<a href="/orders" class="hover:text-brand-600">Orders</a>
		<a href="/account" class="hover:text-brand-600">Account</a>
		<form action="/logout" method="post" class="inline">
			<button type="submit" class="hover:text-brand-600">Sign out</button>
		</form>
	} else {
		<a href="/login" class="hover:text-brand-600">Sign in</a>
		<a href="/register" class="btn-primary">Create account</a>
	}
}

templ ErrorPage(status int, message string) {
	@Layout("Error") {
		<div class="py-16 text-center">
			<p class="text-5xl font-extrabold text-brand-600">{ strconv.Itoa(status) }</p>
			<p class="mt-3 text-stone-600">{ message }</p>
			<a href="/" class="btn-primary mt-6">Back to the store</a>
		</div>
	}
}

templ FieldError(msg string) {
	if msg != "" {
		<p class="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">{ msg }</p>
	}
}
