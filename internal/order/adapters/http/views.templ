package http

import (
	"encoding/json"
	"strconv"

	"github.com/NaheedRayan/goat-architecture/internal/order/app"
	"github.com/NaheedRayan/goat-architecture/internal/order/domain"
	"github.com/NaheedRayan/goat-architecture/internal/platform/money"
	"github.com/NaheedRayan/goat-architecture/internal/platform/ui"
)

templ CheckoutPage(vm CheckoutVM) {
	@ui.Layout("Checkout") {
		<h1 class="mb-6 text-2xl font-bold">Checkout</h1>
		<form method="post" action="/checkout" class="grid gap-8 lg:grid-cols-[1fr_24rem]" x-data={ checkoutData(vm) }>
			<input type="hidden" name="idempotency_key" value={ vm.Form.Key }/>
			<input type="hidden" name="expected_total" value={ strconv.FormatInt(vm.Quote.Pricing.TotalCents, 10) }/>
			<div class="space-y-6">
				if vm.Guest {
					<section class="card space-y-4 p-6" aria-labelledby="contact-h">
						<div class="flex items-baseline justify-between">
							<h2 id="contact-h" class="text-lg font-semibold">Contact</h2>
							<a class="text-sm text-brand-700 hover:underline" href="/login?next=%2Fcheckout">Have an account? Sign in</a>
						</div>
						<div class="grid gap-4 sm:grid-cols-2">
							<div>
								<label class="label" for="name">Your name</label>
								<input class="input" id="name" name="name" value={ vm.Form.Name } maxlength="100" required autocomplete="name"/>
							</div>
							<div>
								<label class="label" for="email">Email</label>
								<input class="input" id="email" type="email" name="email" value={ vm.Form.Email } required autocomplete="email"/>
							</div>
						</div>
						<p class="text-xs text-stone-500">We email your order confirmation and tracking here. No password needed; we will offer to set one up afterwards.</p>
						if vm.SignIn {
							<a class="btn-secondary" href="/login?next=%2Fcheckout">Sign in to continue</a>
						}
					</section>
				}
				<section class="card space-y-4 p-6" aria-labelledby="ship-h">
					<h2 id="ship-h" class="text-lg font-semibold">Delivery address</h2>
					if len(vm.Saved) > 0 {
						<div>
							<label class="label" for="saved">Use a saved address</label>
							<select id="saved" class="input" @change="pick($event.target.value)">
								<option value="">Choose…</option>
								for i, a := range vm.Saved {
									<option value={ strconv.Itoa(i) }>{ a.FullName }, { a.Line1 }, { a.City }</option>
								}
							</select>
						</div>
					}
					<div class="grid gap-4 sm:grid-cols-2">
						@input("full_name", "Full name", "name")
						@input("phone", "Phone", "tel")
					</div>
					@input("line1", "Address line 1", "address-line1")
					@input("line2", "Address line 2 (optional)", "address-line2")
					<div class="grid gap-4 sm:grid-cols-3">
						@input("city", "City", "address-level2")
						@input("postal_code", "Postal code", "postal-code")
						@input("country", "Country", "country-name")
					</div>
				</section>
				if len(vm.Quote.ShippingOptions) > 0 {
					<section class="card p-6" aria-labelledby="method-h">
						<h2 id="method-h" class="mb-3 text-lg font-semibold">Delivery method</h2>
						<div class="space-y-2">
							for _, o := range vm.Quote.ShippingOptions {
								<label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 has-[:checked]:border-brand-700 has-[:checked]:bg-brand-50">
									<input type="radio" name="shipping_method" value={ o.ID.String() } checked?={ o.ID.String() == vm.Form.ShippingMethod } @change="$root.requestSubmit($refs.refresh)" class="mt-1"/>
									<span class="flex-1 text-sm">
										<span class="block font-medium">{ o.Name }
											if o.Eta != "" {
												<span class="font-normal text-stone-500">· { o.Eta }</span>
											}
										</span>
										if o.Description != "" {
											<span class="block text-stone-500">{ o.Description }</span>
										}
									</span>
									<span class="text-sm font-semibold">
										if o.Free {
											Free
										} else {
											{ money.Format(o.PriceCents, vm.Currency) }
										}
									</span>
								</label>
							}
						</div>
					</section>
				}
				<section class="card p-6" aria-labelledby="pay-h">
					<h2 id="pay-h" class="mb-3 text-lg font-semibold">Payment</h2>
					<div class="space-y-2">
						for _, m := range vm.Quote.PaymentMethods {
							<label class="flex cursor-pointer items-start gap-3 rounded-lg border border-stone-200 p-3 has-[:checked]:border-brand-700 has-[:checked]:bg-brand-50">
								<input type="radio" name="payment_method" value={ m } checked?={ m == vm.Form.PaymentMethod } @change="$root.requestSubmit($refs.refresh)" class="mt-1"/>
								<span class="text-sm">
									<span class="block font-medium">{ paymentLabel(m) }</span>
									<span class="block text-stone-500">{ paymentHelp(m) }</span>
								</span>
							</label>
						}
					</div>
				</section>
				<section class="card p-6" aria-labelledby="coupon-h">
					<h2 id="coupon-h" class="mb-3 text-lg font-semibold">Discount code</h2>
					<div class="flex gap-2">
						<label class="sr-only" for="coupon">Discount code</label>
						<input class="input uppercase" id="coupon" name="coupon" value={ vm.Form.Coupon } maxlength="32" autocomplete="off" @keydown.enter.prevent="$refs.refresh.click()"/>
						<button class="btn-secondary" type="submit" name="action" value="refresh" formnovalidate>Apply</button>
					</div>
					if vm.Quote.CouponError != "" {
						<p class="mt-2 text-sm text-red-700" role="alert">{ vm.Quote.CouponError }</p>
					} else if vm.Quote.Coupon != nil {
						<p class="mt-2 text-sm text-emerald-700" role="status">Code { vm.Quote.Coupon.Code } applied.</p>
					}
				</section>
			</div>
			<aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
				<div class="card space-y-3 p-6">
					<h2 class="text-lg font-semibold">Order summary</h2>
					<ul class="divide-y divide-stone-100 text-sm">
						for _, l := range vm.Quote.Cart.Lines {
							<li class="flex justify-between gap-3 py-2">
								<span>{ lineName(l) } × { strconv.Itoa(l.Quantity) }</span>
								<span>{ money.Format(l.UnitPriceCents*int64(l.Quantity), vm.Currency) }</span>
							</li>
						}
					</ul>
					@breakdown(vm.Quote.Pricing, vm.Currency, vm.Quote.TaxLabel, couponCode(vm), shippingName(vm))
					@ui.FieldError(vm.Error)
					<button class="btn-primary w-full" type="submit" name="action" value="place" :disabled="submitting" @click="submitting = $el.form.checkValidity()">
						<span x-text="submitting ? 'Placing order…' : label">{ placeLabel(vm.Form.PaymentMethod) }</span>
					</button>
					<noscript><button class="btn-secondary w-full" type="submit" name="action" value="refresh" formnovalidate>Update totals</button></noscript>
				</div>
			</aside>
			<button type="submit" name="action" value="refresh" formnovalidate x-ref="refresh" class="sr-only" tabindex="-1" aria-hidden="true">Update totals</button>
		</form>
	}
}

templ breakdown(p domain.Pricing, currency, taxLabel, coupon, shipName string) {
	<dl class="space-y-1 border-t border-stone-200 pt-3 text-sm">
		<div class="flex justify-between"><dt>Subtotal</dt><dd>{ money.Format(p.SubtotalCents, currency) }</dd></div>
		if p.DiscountCents > 0 {
			<div class="flex justify-between text-emerald-700"><dt>Discount { coupon }</dt><dd>−{ money.Format(p.DiscountCents, currency) }</dd></div>
		}
		if shipName != "" {
			<div class="flex justify-between">
				<dt>Delivery <span class="text-stone-500">({ shipName })</span></dt>
				<dd>
					if p.ShippingCents == 0 {
						Free
					} else {
						{ money.Format(p.ShippingCents, currency) }
					}
				</dd>
			</div>
		}
		if p.TaxCents > 0 {
			<div class="flex justify-between text-stone-600">
				<dt>
					{ taxLabel }
					if p.TaxInclusive {
						(included)
					}
				</dt>
				<dd>{ money.Format(p.TaxCents, currency) }</dd>
			</div>
		}
		<div class="flex justify-between border-t border-stone-200 pt-2 text-lg font-bold"><dt>Total</dt><dd>{ money.Format(p.TotalCents, currency) }</dd></div>
	</dl>
}

templ input(name, label, autocomplete string) {
	<div>
		<label class="label" for={ name }>{ label }</label>
		<input class="input" id={ name } name={ name } x-model={ "f." + name } autocomplete={ autocomplete } required?={ name != "line2" }/>
	</div>
}

// checkoutData builds the Alpine state: the address fields and the saved addresses.
func checkoutData(vm CheckoutVM) (string, error) {
	type addr struct {
		FullName   string `json:"full_name"`
		Phone      string `json:"phone"`
		Line1      string `json:"line1"`
		Line2      string `json:"line2"`
		City       string `json:"city"`
		PostalCode string `json:"postal_code"`
		Country    string `json:"country"`
	}
	f := vm.Form
	cur := addr{f.FullName, f.Phone, f.Line1, f.Line2, f.City, f.PostalCode, f.Country}
	list := make([]addr, len(vm.Saved))
	for i, a := range vm.Saved {
		list[i] = addr{a.FullName, a.Phone, a.Line1, a.Line2, a.City, a.PostalCode, a.Country}
	}
	fj, err := json.Marshal(cur)
	if err != nil {
		return "", err
	}
	sj, err := json.Marshal(list)
	if err != nil {
		return "", err
	}
	lj, err := json.Marshal(placeLabel(f.PaymentMethod))
	if err != nil {
		return "", err
	}
	return "{ submitting: false, label: " + string(lj) + ", f: " + string(fj) + ", saved: " + string(sj) +
		", pick(i) { if (i === '') return; this.f = { ...this.f, ...this.saved[+i] } } }", nil
}

func paymentLabel(m string) string {
	if m == domain.MethodCOD {
		return "Cash on delivery"
	}
	return "Pay online"
}

func paymentHelp(m string) string {
	if m == domain.MethodCOD {
		return "Pay the courier when your order arrives."
	}
	return "You will complete the payment securely on the next step."
}

func placeLabel(method string) string {
	if method == domain.MethodCOD {
		return "Place order (pay on delivery)"
	}
	return "Place order & pay"
}

func couponCode(vm CheckoutVM) string {
	if vm.Quote.Coupon != nil {
		return "(" + vm.Quote.Coupon.Code + ")"
	}
	return ""
}

func shippingName(vm CheckoutVM) string {
	if vm.Quote.Shipping != nil {
		return vm.Quote.Shipping.Name
	}
	return ""
}

func lineName(l app.CartLine) string {
	if l.Label == "" {
		return l.Name
	}
	return l.Name + " — " + l.Label
}

// ---- orders ----

templ ListPage(orders []domain.Order) {
	@ui.Layout("Your orders") {
		<h1 class="mb-6 text-2xl font-bold">Your orders</h1>
		if len(orders) == 0 {
			<div class="card p-10 text-center">
				<p class="text-stone-500">You haven't placed any orders yet.</p>
				<a href="/products" class="btn-primary mt-4">Start shopping</a>
			</div>
		} else {
			<ul class="card divide-y divide-stone-200">
				for _, o := range orders {
					<li>
						<a href={ templ.SafeURL("/orders/" + o.ID.String()) } class="flex items-center justify-between gap-4 p-4 hover:bg-stone-50">
							<div>
								<p class="font-medium">Order { shortID(o.ID.String()) }</p>
								<p class="text-sm text-stone-500">{ o.CreatedAt.Format("2 Jan 2006, 15:04") }</p>
							</div>
							@ui.StatusBadge(o.Status)
							<p class="font-semibold">{ money.Format(o.TotalCents, o.Currency) }</p>
						</a>
					</li>
				}
			</ul>
		}
	}
}

templ DetailPage(vm DetailVM) {
	@ui.Layout("Order " + shortID(vm.Order.ID.String())) {
		<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
			<h1 class="text-2xl font-bold">Order { shortID(vm.Order.ID.String()) }</h1>
			@ui.StatusBadge(vm.Order.Status)
		</div>
		if vm.Placed && vm.Order.Status != domain.StatusAwaitingPayment {
			<div class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900" role="status">
				<p class="font-semibold">Thank you! Your order is confirmed.</p>
				<p class="text-sm">We emailed the details to { vm.Order.ContactEmail }.</p>
			</div>
		}
		if vm.Order.Status == domain.StatusAwaitingPayment && vm.Order.PaymentID != nil {
			<div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-amber-300 bg-amber-50 p-4">
				<p class="text-sm text-amber-900">Your items are reserved for a short time. Complete payment to confirm the order.</p>
				<a class="btn-primary" href={ templ.SafeURL("/pay/" + vm.Order.PaymentID.String()) }>Pay now</a>
			</div>
		}
		@ui.FieldError(vm.Error)
		<div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
			<div class="space-y-6">
				<ul class="card divide-y divide-stone-200">
					for _, it := range vm.Order.Items {
						<li class="flex justify-between gap-4 p-4 text-sm">
							<span>{ it.DisplayName() } × { strconv.Itoa(it.Quantity) }</span>
							<span class="font-medium">{ money.Format(it.SubtotalCents(), vm.Order.Currency) }</span>
						</li>
					}
					<li class="p-4">
						@breakdown(domain.Pricing{SubtotalCents: vm.Order.SubtotalCents, DiscountCents: vm.Order.DiscountCents, ShippingCents: vm.Order.ShippingCents, TaxCents: vm.Order.TaxCents, TotalCents: vm.Order.TotalCents, TaxInclusive: vm.Order.TaxInclusive}, vm.Order.Currency, vm.TaxLabel, couponSuffix(vm.Order.CouponCode), vm.Order.ShippingMethod)
					</li>
				</ul>
				@Timeline(vm.Order)
			</div>
			<aside class="space-y-4">
				<div class="card space-y-1 p-5 text-sm">
					<h2 class="mb-2 font-semibold">Ships to</h2>
					<p>{ vm.Order.Shipping.FullName }</p>
					<p>{ vm.Order.Shipping.Line1 }</p>
					if vm.Order.Shipping.Line2 != "" {
						<p>{ vm.Order.Shipping.Line2 }</p>
					}
					<p>{ vm.Order.Shipping.City }, { vm.Order.Shipping.PostalCode }</p>
					<p>{ vm.Order.Shipping.Country }</p>
					<p class="text-stone-500">{ vm.Order.Shipping.Phone }</p>
					<p class="pt-2 text-stone-500">Payment: { paymentSummary(vm.Order) }</p>
				</div>
				if !vm.Order.Tracking.Empty() {
					<div class="card space-y-1 p-5 text-sm">
						<h2 class="mb-2 font-semibold">Tracking</h2>
						if vm.Order.Tracking.Carrier != "" {
							<p>Carrier: { vm.Order.Tracking.Carrier }</p>
						}
						if vm.Order.Tracking.Number != "" {
							<p>Number: <span class="font-mono">{ vm.Order.Tracking.Number }</span></p>
						}
						if vm.Order.Tracking.URL != "" {
							<a class="btn-secondary mt-2" href={ templ.SafeURL(vm.Order.Tracking.URL) } target="_blank" rel="noopener noreferrer">Track parcel</a>
						}
					</div>
				}
				if vm.Order.Return.Status != "" {
					<div class="card space-y-1 p-5 text-sm">
						<h2 class="mb-2 font-semibold">Return</h2>
						<p>{ returnLabel(vm.Order.Return.Status) }</p>
						<p class="text-stone-500">Your reason: { vm.Order.Return.Reason }</p>
						if vm.Order.Return.Note != "" {
							<p class="text-stone-700">Reply from the store: { vm.Order.Return.Note }</p>
						}
					</div>
				}
				if vm.CanCancel {
					<div class="card p-5">
						<h2 class="mb-1 font-semibold">Changed your mind?</h2>
						<p class="mb-3 text-xs text-stone-500">You can cancel until we start preparing your order.
							if vm.Order.Status == domain.StatusPaid && vm.Order.PaymentMethod == domain.MethodCard {
								Your payment is refunded.
							}
						</p>
						<form method="post" action={ templ.SafeURL("/orders/" + vm.Order.ID.String() + "/cancel") } data-msg="Cancel this order?" @submit="if (!confirm($el.dataset.msg)) $event.preventDefault()">
							<button class="btn-danger w-full" type="submit">Cancel order</button>
						</form>
					</div>
				}
				if vm.CanReturn {
					<details class="card p-5" open?={ vm.Error != "" }>
						<summary class="cursor-pointer font-semibold">Return this order</summary>
						<form method="post" action={ templ.SafeURL("/orders/" + vm.Order.ID.String() + "/return") } class="mt-3 space-y-3">
							<p class="text-xs text-stone-500">You can request a return until { vm.ReturnDeadline.Format("2 Jan 2006") }.</p>
							<label class="label" for="reason">Why are you returning it?</label>
							<textarea class="input" id="reason" name="reason" rows="3" maxlength="500" required></textarea>
							<button class="btn-secondary w-full" type="submit">Request return</button>
						</form>
					</details>
				}
			</aside>
		</div>
	}
}

templ Timeline(o domain.Order) {
	if len(o.Events) > 0 {
		<section class="card p-5" aria-labelledby="timeline-h">
			<h2 id="timeline-h" class="mb-3 font-semibold">Order history</h2>
			<ol class="space-y-3 border-l border-stone-200 pl-4 text-sm">
				for _, e := range o.Events {
					<li class="relative">
						<span class="absolute -left-[1.4rem] top-1.5 h-2 w-2 rounded-full bg-brand-700" aria-hidden="true"></span>
						<p class="font-medium">{ e.Detail }</p>
						<p class="text-xs text-stone-500">{ e.At.Format("2 Jan 2006, 15:04") }</p>
					</li>
				}
			</ol>
		</section>
	}
}

func couponSuffix(code string) string {
	if code == "" {
		return ""
	}
	return "(" + code + ")"
}

func paymentSummary(o domain.Order) string {
	switch {
	case o.PaymentMethod == domain.MethodCOD && o.Status == domain.StatusDelivered:
		return "cash on delivery (collected)"
	case o.PaymentMethod == domain.MethodCOD:
		return "cash on delivery (pay the courier)"
	case o.Status == domain.StatusAwaitingPayment:
		return "online (awaiting payment)"
	case o.Status == domain.StatusRefunded || o.Status == domain.StatusCancelled && o.RefundCents > 0:
		return "online (refunded)"
	}
	return "online (paid)"
}

func returnLabel(status string) string {
	switch status {
	case domain.ReturnRequested:
		return "Return requested: we are reviewing it."
	case domain.ReturnApproved:
		return "Return approved: your refund was issued."
	case domain.ReturnRejected:
		return "Return declined."
	}
	return status
}

func shortID(id string) string { return "#" + id[len(id)-8:] }
