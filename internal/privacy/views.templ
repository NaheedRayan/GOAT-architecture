package privacy

import "github.com/NaheedRayan/goat-architecture/internal/platform/ui"

templ GoodbyePage() {
	@ui.Layout("Account deleted") {
		<div class="mx-auto max-w-md py-12 text-center">
			<h1 class="text-2xl font-bold">Your account has been deleted</h1>
			<p class="mt-3 text-stone-600">Your personal data has been removed. Order records needed for accounting are kept without your name or address.</p>
			<a href="/" class="btn-primary mt-6">Back to the store</a>
		</div>
	}
}
